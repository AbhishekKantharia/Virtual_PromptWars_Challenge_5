# Optional server-side AI configuration for the opt-in AI idea enhancement.
# The app works fully without these values in deterministic demo mode.
# Never commit real keys. Set these in your shell before starting the server.
# npm scripts do not load .env automatically; see README.md for details.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Optional server settings
PORT=8787
HOST=127.0.0.1
